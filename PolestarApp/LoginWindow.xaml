<Window x:Class="LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolestarApp"
        mc:Ignorable="d"
        Title="Polestar · Iniciar sesión" Height="720" Width="1280" WindowStartupLocation="CenterScreen" Background="#FFF2F2F2" MinWidth="1280" MinHeight="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="ImgLogo" Grid.Column="0"
                Source="/Assets/polestarlogo.png"
                Stretch="Uniform" Margin="12"/>
            <Button x:Name="BtnMenu" Style="{DynamicResource BotonMenu}" Content="☰  Menú" Grid.Column="2" Margin="12,12,12,12" Background="White" BorderBrush="Black" BorderThickness="1" Cursor="Hand" FontSize="18"/>
        </Grid>
        <Border x:Name="MenuPanel" Background="White" BorderBrush="Black" BorderThickness="1" Grid.Row="1" Panel.ZIndex="10" Width="200" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="0"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel x:Name="MenuItems">
                <Button x:Name="BtnInicio" Style="{DynamicResource BotonMenu}" Content="Inicio" Height="44" Cursor="Hand" FontSize="15" BorderThickness="0,0,0,0" Background="White"/>
                <Button x:Name="BtnCatalogo" Style="{DynamicResource BotonMenu}" Content="Catálogo" Height="44" Cursor="Hand" FontSize="15" BorderThickness="0,0,0,0" Background="White"/>
                <Button x:Name="BtnLogin" Style="{DynamicResource BotonMenu}" Content="Iniciar sesión" Height="44" Cursor="Hand" FontSize="15" FontWeight="SemiBold" BorderThickness="4,0,0,0" Background="#FFF2F2F2"/>
            </StackPanel>
        </Border>
        <Border x:Name="TarjetaLogin" BorderBrush="Black" Grid.Row="1" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="6" Padding="40,40,40,40" Panel.ZIndex="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TxtTituloLogin" TextWrapping="Wrap" Text="Iniciar sesión" FontSize="28" FontWeight="Bold" Foreground="#FF101010"/>
                <TextBlock x:Name="TxtSubLogin" TextWrapping="Wrap" Text="Accede con tu cuenta de cliente" FontSize="14" Foreground="#FF444444" Margin="0,0,0,24"/>
                <TextBlock x:Name="LblCorreo" TextWrapping="Wrap" Text="Correo electrónico" FontSize="13" Margin="0,0,0,6" Foreground="#FF101010"/>
                <TextBox x:Name="TxtCorreo" TextWrapping="NoWrap" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,16" FontSize="15"/>
                <TextBlock x:Name="LblContrasena" TextWrapping="Wrap" Text="Contraseña" FontSize="13" Foreground="#FF101010" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PwdContrasena" Height="40" VerticalContentAlignment="Center" FontSize="15" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtError" TextWrapping="Wrap" Text="Correo o contraseña incorrectos" FontSize="13" Foreground="#FFC62828" Margin="0,0,0,8" Visibility="Collapsed"/>
                <Button x:Name="BtnEntrar" Style="{DynamicResource BotonOscuro}" Content="Entrar" Height="44" FontSize="16" Background="#FF101010" Foreground="White" BorderThickness="0" Margin="0,8,0,0" Cursor="Hand" IsDefault="True"/>
                <TextBlock x:Name="TxtOlvido" TextWrapping="Wrap" Text="¿Olvidaste tu contraseña?" FontSize="13" Foreground="#FF444444" HorizontalAlignment="Center" Cursor="Hand" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
        <Image x:Name="ImgFondoLogin" Source="/Assets/login_fondo.jpg" Grid.Row="1" Stretch="UniformToFill"/>

    </Grid>
</Window>
