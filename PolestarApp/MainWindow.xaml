<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolestarApp"
        mc:Ignorable="d"
        Title="Polestar" Height="720" Width="1280" WindowStartupLocation="CenterScreen" MinWidth="1280" MinHeight="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="ImgLogo" Grid.Column="0"
               Source="Assets/polestarlogo.png"
               Stretch="Uniform" Margin="12"/>
            <Button x:Name="BtnMenu" Style="{DynamicResource BotonMenu}" Content="☰  Menú" Grid.Column="2" Margin="12,12,12,12" Background="White" BorderBrush="Black" BorderThickness="1" Cursor="Hand" FontSize="18"/>
        </Grid>
        <Border x:Name="MenuPanel" Background="White" BorderBrush="Black" BorderThickness="1" Grid.Row="1" Panel.ZIndex="10" Width="200" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="0"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel x:Name="MenuItems">
                <Button x:Name="BtnInicio" Style="{DynamicResource BotonMenu}" Content="Inicio" Height="44" Cursor="Hand" FontSize="15" FontWeight="SemiBold" BorderThickness="4,0,0,0" Background="#FFF2F2F2"/>
                <Button x:Name="BtnCatalogo" Style="{DynamicResource BotonMenu}" Content="Catálogo" Height="44" Cursor="Hand" FontSize="15" BorderThickness="0,0,0,0" Background="White"/>
                <Button x:Name="BtnLogin" Style="{DynamicResource BotonMenu}" Content="Iniciar sesión" Height="44" Cursor="Hand" FontSize="15" BorderThickness="0,0,0,0" Background="White"/>
            </StackPanel>
        </Border>
        <Grid x:Name="Hero" Grid.Row="1" Background="#FFF2F2F2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image x:Name="ImgHero" Source="/Assets/hero.jpg" Stretch="UniformToFill" Grid.Column="1"/>
            <StackPanel x:Name="HeroTexto" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="60,0,0,0">
                <TextBlock x:Name="TxtTitulo" TextWrapping="Wrap" Text="Nuevo Polestar 2" FontSize="44" FontWeight="Bold" Foreground="#FF101010"/>
                <TextBlock x:Name="TxtSubtitulo" TextWrapping="Wrap" Text="100 % eléctrico. Diseño escandinavo." FontSize="18" Foreground="#FF444444" Margin="0,12,0,0"/>
                <Button Style="{DynamicResource BotonOscuro}" x:Name="BtnVerCatalogo" Content="Ver catálogo" Width="180" Height="44" HorizontalAlignment="Left" Margin="0,28,0,0" FontSize="16" Background="#FF101010" Foreground="White" Cursor="Hand" BorderThickness="0,0,0,0"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="Ofertas" Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtOfertas" TextWrapping="Wrap" Text="Ofertas de otoño" Grid.ColumnSpan="2" FontSize="22" FontWeight="Bold" Foreground="#FF101010" Margin="60,0,0,0" VerticalAlignment="Center"/>
            <Border x:Name="Oferta1" BorderBrush="Black" Grid.Row="1" Margin="60,0,20,20" Background="#FFF2F2F2" CornerRadius="6,6,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock x:Name="TxtModelo1" TextWrapping="Wrap" Text="Polestar 3" FontSize="20" FontWeight="Bold" Foreground="#FF101010"/>
                        <TextBlock x:Name="TxtCaract1" TextWrapping="Wrap" Text="SUV eléctrico · Tracción total" FontSize="14" Margin="0,4,0,0" Foreground="#FF101010"/>
                        <TextBlock x:Name="TxtPrecioAntes1" TextWrapping="Wrap" Text="79.900 €" FontSize="14" TextDecorations="Strikethrough" Margin="0,10,0,0" Foreground="#FF777777"/>
                        <TextBlock x:Name="TxtPrecio1" TextWrapping="Wrap" Text="74.900 €" FontSize="22" FontWeight="Bold"/>
                        <Button Style="{DynamicResource BotonOscuro}" x:Name="BtnDetalles1" Content="Ver detalles" Width="140" Height="36" Background="#FF101010" Margin="0,10,0,0" Cursor="Hand" HorizontalAlignment="Left" Foreground="White" BorderThickness="0,0,0,0" FontSize="14"/>
                    </StackPanel>
                    <Image x:Name="ImgOferta1" Source="/Assets/oferta_polestar3.jpg" Stretch="UniformToFill"/>
                </Grid>
            </Border>
            <Border x:Name="Oferta2" BorderBrush="Black" Grid.Row="1" Margin="20,0,60,20" Background="#FFF2F2F2" CornerRadius="6,6,6,6" Grid.Column="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock x:Name="TxtModelo2" TextWrapping="Wrap" Text="Polestar 4" FontSize="20" FontWeight="Bold" Foreground="#FF101010"/>
                        <TextBlock x:Name="TxtCaract2" TextWrapping="Wrap" Text="SUV coupé eléctrico · 5 plazas" FontSize="14" Margin="0,4,0,0" Foreground="#FF101010"/>
                        <TextBlock x:Name="TxtPrecioAntes2" TextWrapping="Wrap" Text="66.900 €" FontSize="14" TextDecorations="Strikethrough" Margin="0,10,0,0" Foreground="#FF777777"/>
                        <TextBlock x:Name="TxtPrecio2" TextWrapping="Wrap" Text="62.900 €" FontSize="22" FontWeight="Bold"/>
                        <Button Style="{DynamicResource BotonOscuro}" x:Name="BtnDetalles2" Content="Ver detalles" Width="140" Height="36" Background="#FF101010" Margin="0,10,0,0" Cursor="Hand" HorizontalAlignment="Left" Foreground="White" BorderThickness="0,0,0,0" FontSize="14"/>
                    </StackPanel>
                    <Image x:Name="ImgOferta2" Source="/Assets/oferta_polestar4.jpg" Stretch="UniformToFill"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>


</Window>
