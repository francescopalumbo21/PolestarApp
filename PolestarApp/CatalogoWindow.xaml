<Window x:Class="CatalogoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PolestarApp"
        mc:Ignorable="d"
        Title="Polestar · Catálogo" Height="720" Width="1280" WindowStartupLocation="CenterScreen" Background="#FFF2F2F2" MinWidth="1280" MinHeight="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="ImgLogo" Grid.Column="0"
                Source="/Assets/polestarlogo.png"
                Stretch="Uniform" Margin="12"/>
            <Button x:Name="BtnMenu" Style="{DynamicResource BotonMenu}" Content="☰  Menú" Grid.Column="2" Margin="12,12,12,12" Background="White" BorderBrush="Black" BorderThickness="1" Cursor="Hand" FontSize="18"/>
        </Grid>
        <Border x:Name="MenuPanel" Background="White" BorderBrush="Black" BorderThickness="1" Grid.Row="1" Panel.ZIndex="10" Width="200" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="0"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel x:Name="MenuItems">
                <Button x:Name="BtnInicio" Style="{DynamicResource BotonMenu}" Content="Inicio" Height="44" Cursor="Hand" FontSize="15" BorderThickness="0,0,0,0" Background="White"/>
                <Button x:Name="BtnCatalogo" Style="{DynamicResource BotonMenu}" Content="Catálogo" Height="44" Cursor="Hand" FontSize="15" FontWeight="SemiBold" BorderThickness="4,0,0,0" Background="#FFF2F2F2"/>
                <Button x:Name="BtnLogin" Style="{DynamicResource BotonMenu}" Content="Iniciar sesión" Height="44" Cursor="Hand" FontSize="15" BorderThickness="0,0,0,0" Background="White"/>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="ScrollCatalogo" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContenidoCatalogo" Margin="60,30,60,30">
                <TextBlock x:Name="TxtTituloCatalogo" TextWrapping="Wrap" Text="Nuestros modelos" FontSize="28" FontWeight="Bold" Foreground="#FF101010"/>
                <TextBlock x:Name="TxtSubCatalogo" TextWrapping="Wrap" Text="Toda la gama eléctrica de Polestar" FontSize="14" Foreground="#FF444444" Margin="0,0,0,24"/>
                <WrapPanel x:Name="GaleriaModelos">
                    <Border x:Name="Modelo2" BorderBrush="Black" Width="350" Margin="0,0,20,20" Background="White" CornerRadius="12,12,12,12" Padding="20,20,20,20">
                        <StackPanel>
                            <TextBlock x:Name="TxtNombre2" TextWrapping="Wrap" Text="Polestar 2" FontSize="24" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center"/>
                            <StackPanel x:Name="Etiquetas2" Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Border BorderBrush="Black" Background="#FFE6E6E6" Padding="8,3,8,3" CornerRadius="3,3,3,3" Margin="0,0,6,0">
                                    <TextBlock TextWrapping="Wrap" Text="Berlina" FontWeight="Bold" Foreground="#FF101010"/>
                                </Border>
                            </StackPanel>
                            <Image x:Name="ImgModelo2" Height="180" Source="/Assets/catalogo_polestar2.jpg" Stretch="UniformToFill" Margin="0,14,0,0"/>
                            <TextBlock x:Name="TxtDesc2" TextWrapping="Wrap" Text="Berlina eléctrica para el día a día." Foreground="#FF444444" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" FontSize="13" TextAlignment="Center"/>
                            <TextBlock x:Name="TxtDesde2" TextWrapping="Wrap" Text="desde" Foreground="#FF444444" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPrecio2" TextWrapping="Wrap" Text="49.900 €" FontSize="20" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Modelo3" BorderBrush="Black" Width="350" Margin="0,0,20,20" Background="White" CornerRadius="12,12,12,12" Padding="20,20,20,20">
                        <StackPanel>
                            <TextBlock x:Name="TxtNombre1" TextWrapping="Wrap" Text="Polestar 3" FontSize="24" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center"/>
                            <StackPanel x:Name="Etiquetas1" Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Border BorderBrush="Black" Background="#FFE6E6E6" Padding="8,3,8,3" CornerRadius="3,3,3,3" Margin="0,0,6,0">
                                    <TextBlock TextWrapping="Wrap" Text="SUV" FontWeight="Bold" Foreground="#FF101010"/>
                                </Border>
                            </StackPanel>
                            <Image x:Name="ImgModelo1" Height="180" Source="/Assets/catalogo_polestar3.jpg" Stretch="UniformToFill" Margin="0,14,0,0"/>
                            <TextBlock x:Name="TxtDesc1" TextWrapping="Wrap" Text="SUV de lujo con tracción total." Foreground="#FF444444" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" FontSize="13" TextAlignment="Center"/>
                            <TextBlock x:Name="TxtDesde1" TextWrapping="Wrap" Text="desde" Foreground="#FF444444" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPrecio1" TextWrapping="Wrap" Text="79.900 €" FontSize="20" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Modelo4" BorderBrush="Black" Width="350" Margin="0,0,20,20" Background="White" CornerRadius="12,12,12,12" Padding="20,20,20,20">
                        <StackPanel>
                            <TextBlock x:Name="TxtNombre3" TextWrapping="Wrap" Text="Polestar 4" FontSize="24" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center"/>
                            <StackPanel x:Name="Etiquetas3" Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Border BorderBrush="Black" Background="#FFE6E6E6" Padding="8,3,8,3" CornerRadius="3,3,3,3" Margin="0,0,6,0">
                                    <TextBlock TextWrapping="Wrap" Text="SUV coupé" FontWeight="Bold" Foreground="#FF101010"/>
                                </Border>
                            </StackPanel>
                            <Image x:Name="ImgModelo3" Height="180" Source="/Assets/catalogo_polestar4.jpg" Stretch="UniformToFill" Margin="0,14,0,0"/>
                            <TextBlock x:Name="TxtDesc3" TextWrapping="Wrap" Text="SUV coupé amplio y deportivo." Foreground="#FF444444" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" FontSize="13" TextAlignment="Center"/>
                            <TextBlock x:Name="TxtDesde3" TextWrapping="Wrap" Text="desde" Foreground="#FF444444" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPrecio3" TextWrapping="Wrap" Text="66.900 €" FontSize="20" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Modelo5" BorderBrush="Black" Width="350" Margin="0,0,20,20" Background="White" CornerRadius="12,12,12,12" Padding="20,20,20,20">
                        <StackPanel>
                            <TextBlock x:Name="TxtNombre4" TextWrapping="Wrap" Text="Polestar 5" FontSize="24" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center"/>
                            <StackPanel x:Name="Etiquetas4" Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Border BorderBrush="Black" Background="#FFE6E6E6" Padding="8,3,8,3" CornerRadius="3,3,3,3" Margin="0,0,6,0">
                                    <TextBlock TextWrapping="Wrap" Text="Gran Turismo" FontWeight="Bold" Foreground="#FF101010"/>
                                </Border>
                                <Border BorderBrush="Black" Background="#FF101010" Padding="8,3,8,3" CornerRadius="3,3,3,3">
                                    <TextBlock TextWrapping="Wrap" Text="Nuevo" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <Image x:Name="ImgModelo4" Height="180" Source="/Assets/catalogo_polestar5.jpg" Stretch="UniformToFill" Margin="0,14,0,0"/>
                            <TextBlock x:Name="TxtDesc4" TextWrapping="Wrap" Text="Gran turismo de cuatro puertas y altas prestaciones." Foreground="#FF444444" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" FontSize="13" TextAlignment="Center"/>
                            <TextBlock x:Name="TxtDesde4" TextWrapping="Wrap" Text="desde" Foreground="#FF444444" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPrecio4" TextWrapping="Wrap" Text="119.900 €" FontSize="20" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Modelo6" BorderBrush="Black" Width="350" Margin="0,0,20,20" Background="White" CornerRadius="12,12,12,12" Padding="20,20,20,20">
                        <StackPanel>
                            <TextBlock x:Name="TxtNombre5" TextWrapping="Wrap" Text="Polestar 6" FontSize="24" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center"/>
                            <StackPanel x:Name="Etiquetas5" Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Border BorderBrush="Black" Background="#FFE6E6E6" Padding="8,3,8,3" CornerRadius="3,3,3,3" Margin="0,0,6,0">
                                    <TextBlock TextWrapping="Wrap" Text="Roadster" FontWeight="Bold" Foreground="#FF101010"/>
                                </Border>
                                <Border BorderBrush="Black" Background="#FF101010" Padding="8,3,8,3" CornerRadius="3,3,3,3">
                                    <TextBlock TextWrapping="Wrap" Text="Próximamente" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <Image x:Name="ImgModelo5" Height="180" Source="/Assets/catalogo_polestar6.jpg" Stretch="UniformToFill" Margin="0,14,0,0"/>
                            <TextBlock x:Name="TxtDesc5" TextWrapping="Wrap" Text="Roadster eléctrico de dos plazas." Foreground="#FF444444" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" FontSize="13" TextAlignment="Center"/>
                            <TextBlock x:Name="TxtDesde5" TextWrapping="Wrap" Text="precio" Foreground="#FF444444" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtPrecio5" TextWrapping="Wrap" Text="Próximamente" FontSize="20" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
